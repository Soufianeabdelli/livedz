{
  "name": "livedz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "db:seed": "tsx prisma/seed.ts",
    "db:claim": "tsx prisma/claim.ts",
    "db:communes": "tsx prisma/seed-communes.ts",
    "couriers:sync": "node scripts/sync-couriers.mjs",
    "worker:live": "tsx src/worker/live-worker.ts",
    "db:migrate": "prisma migrate dev && prisma generate",
    "postinstall": "prisma generate",
    "check": "eslint . && tsc --noEmit && vitest run && next build"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@types/qrcode": "^1.5.6",
    "dotenv": "18.0.10",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "next": "16.4.6",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tiktok-live-connector": "^2.5.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.1"
  },
  "overrides": {
    "effect": "3.22.5",
    "@grpc/grpc-js": "1.14.7"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  }
}
