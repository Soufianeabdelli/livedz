generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MODERATOR
}

model Merchant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  createdAt  DateTime     @default(now())
  members    Membership[]
  products   Product[]
  affiliates Affiliate[]
  cards      Card[]
}

// userId will come from the auth system later. No passwords here.
model Membership {
  id         String   @id @default(cuid())
  userId     String
  merchantId String
  role       Role     @default(MODERATOR)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model Product {
  id         String    @id @default(cuid())
  merchantId String
  code       String    // "01" is shown as #01
  name       String
  priceDzd   Int       // integer dinars only
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants   Variant[]
  cards      Card[]

  @@unique([merchantId, code])
}

model Variant {
  id        String  @id @default(cuid())
  productId String
  size      String  @default("") // "" instead of NULL so the unique rule works
  color     String  @default("")
  stock     Int     @default(0)
  reserved  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, size, color])
}

model Affiliate {
  id            String   @id @default(cuid())
  merchantId    String
  handle        String
  commissionBps Int      // basis points: 1000 = 10%
  phoneHmac     String?  // HMAC with a secret key, never a plain hash
  isActive      Boolean  @default(true)
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cards         Card[]

  @@unique([merchantId, handle])
}

// Each printed or overlay card has a random, unguessable token: /q/{token}
model Card {
  id          String     @id @default(cuid())
  token       String     @unique
  merchantId  String
  productId   String?
  affiliateId String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  merchant    Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)

  @@index([merchantId])
}