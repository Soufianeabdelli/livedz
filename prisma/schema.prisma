generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  MODERATOR
}

enum OrderStatus {
  DRAFT
  NEEDS_INFO
  AWAITING_CUSTOMER
  CONFIRMED
  SHIPMENT_PENDING
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
  FAILED
}

enum OrderSource {
  QR_LINK
  MANUAL
  LIVE_COMMENT
}

enum DeliveryType {
  HOME
  STOPDESK
}

model Merchant {
  id         String       @id @default(cuid())
  name       String
  slug       String       @unique
  createdAt  DateTime     @default(now())
  members    Membership[]
  products   Product[]
  affiliates Affiliate[]
  cards      Card[]
  orders     Order[]
  courierAccounts CourierAccount[]
}

model Membership {
  id         String   @id @default(cuid())
  userId     String
  merchantId String
  role       Role     @default(MODERATOR)
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([userId, merchantId])
  @@index([merchantId])
}

model Product {
  id         String    @id @default(cuid())
  merchantId String
  code       String
  name       String
  priceDzd   Int
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  variants   Variant[]
  cards      Card[]

  @@unique([merchantId, code])
}

model Variant {
  id         String      @id @default(cuid())
  productId  String
  size       String      @default("")
  color      String      @default("")
  stock      Int         @default(0)
  reserved   Int         @default(0)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([productId, size, color])
}
model Affiliate {
  id            String   @id @default(cuid())
  merchantId    String
  handle        String
  commissionBps Int
  phoneHmac     String?
  isActive      Boolean  @default(true)
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  cards         Card[]
  orders        Order[]

  @@unique([merchantId, handle])
}

model Card {
  id          String     @id @default(cuid())
  token       String     @unique
  merchantId  String
  productId   String?
  affiliateId String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  merchant    Merchant   @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  product     Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  affiliate   Affiliate? @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  orders      Order[]

  @@index([merchantId])
}
model Order {
  id               String        @id @default(cuid())
  merchantId       String
  status           OrderStatus   @default(DRAFT)
  source           OrderSource
  idempotencyKey   String
  cardId           String?
  affiliateId      String?
  customerName     String?
  phone            String?
  wilayaCode       Int?
  commune          String?
  deliveryType     DeliveryType?
  address          String?
  totalDzd         Int           @default(0)
  messagingConsent Boolean       @default(false)
  consentAt        DateTime?
  courier          String?
  trackingNumber   String?
  note             String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchant         Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  card             Card?         @relation(fields: [cardId], references: [id], onDelete: SetNull)
  affiliate        Affiliate?    @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  items            OrderItem[]

  @@unique([merchantId, idempotencyKey])
  @@index([merchantId, status])
  @@index([merchantId, createdAt])
  @@index([merchantId, phone])
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  variantId    String
  productName  String
  quantity     Int     @default(1)
  unitPriceDzd Int
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant      Variant @relation(fields: [variantId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
model Commune {
  id         Int    @id @default(autoincrement())
  wilayaCode Int
  name       String
  nameAr     String

  @@unique([wilayaCode, name])
  @@index([wilayaCode])
}
model CourierAccount {
  id             String   @id @default(cuid())
  merchantId     String
  courier        String
  credentialsEnc String
  hint           String
  fromWilaya     Int
  createdAt      DateTime @default(now())
  merchant       Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@unique([merchantId, courier])
}